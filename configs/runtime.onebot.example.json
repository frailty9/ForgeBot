{
  "bot": {
    "name": "ForgeBot",
    "system_prompt": "你是本项目的技术支持助手。只回答本项目的接口、部署与故障排查问题；可简短回应寒暄；其他领域的专业问题请礼貌说明不在服务范围内。涉及项目文档内容时先调用 search_docs，查不到就说明不知道并建议联系管理员。"
  },
  "llm": {
    "authentication": "api_key",
    "image_understanding": false,
    "protocol": "openai_responses",
    "base_url": "https://api.openai.com/v1",
    "api_key_ref": "llm/default",
    "model": "gpt-5",
    "timeout": "60s"
  },
  "platforms": {
    "connectors": [
      {
        "id": "qq-main",
        "type": "onebot",
        "enabled": true,
        "prompt_suffix": "当前回复将发送到不支持 Markdown 的聊天渠道，请使用纯文本。",
        "options": {
          "api_url": "http://127.0.0.1:5700",
          "send_token": "",
          "webhook_addr": "127.0.0.1:8090",
          "webhook_path": "/onebot/qq-main",
          "receive_secret": ""
        }
      }
    ],
    "groups": [
      {"id": "support", "connector_id": "qq-main", "target": "10001", "prompt_suffix": "这是技术支持群，请优先给出简洁、可执行的步骤。"},
      {"id": "ops", "connector_id": "qq-main", "target": "10002"}
    ]
  },
  "modules": {
    "native.onebot": {"enabled": true, "options": {}},
    "native.join_review": {
      "enabled": true,
      "options": {
        "regex": "^.{4,}$",
        "model_enabled": false,
        "rule": "申请内容须说明入群目的，并符合本群主题。",
        "combine": "and",
        "reject_reason": "请填写至少 4 个字的入群申请说明。",
        "groups": {
          "support": {"enabled": true}
        }
      }
    },
    "native.welcome": {
      "enabled": true,
      "options": {
        "groups": {
          "support": {"enabled": true, "text": "欢迎 {user} 加入！提问时请 @我，并附上报错信息。"}
        }
      }
    },
    "native.proactive_reply": {
      "enabled": true,
      "options": {
        "scope": "本项目的接口、部署与故障排查",
        "groups": {
          "support": {"enabled": true}
        }
      }
    }
  },
  "operator": {
    "conversation_id": "ops",
    "notifications": true,
    "commands": ["status", "restart", "pause", "resume", "proactive", "reload_docs"]
  }
}

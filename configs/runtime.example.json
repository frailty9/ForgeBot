{
  "bot": {
    "name": "ForgeBot",
    "system_prompt": ""
  },
  "llm": {
    "authentication": "api_key",
    "image_understanding": false,
    "protocol": "openai_responses",
    "base_url": "https://api.openai.com/v1",
    "api_key_ref": "llm/default",
    "model": "gpt-5",
    "anthropic_version": "2023-06-01",
    "timeout": "60s"
  },
  "decision": {
    "dm": {
      "enabled": false,
      "protocol": "jev",
      "endpoint": "https://api.typesafe.ai",
      "model": "jev-latest",
      "api_key_ref": "decision/default",
      "min_confidence": 0.6
    },
    "dm_timeout": "3s",
    "llm_timeout": "8s",
    "max_concurrent": 16
  },
  "platforms": {
    "connectors": [
      {
        "id": "echo-local",
        "type": "echo",
        "enabled": true,
        "prompt_suffix": "",
        "options": {}
      },
      {
        "id": "qq-main",
        "type": "onebot",
        "enabled": false,
        "prompt_suffix": "当前回复将发送到不支持 Markdown 的聊天渠道，请使用纯文本。",
        "options": {
          "api_url": "http://127.0.0.1:5700",
          "send_token": "",
          "webhook_addr": "127.0.0.1:8090",
          "webhook_path": "/onebot/qq-main",
          "receive_secret": "",
          "request_limit": 1048576,
          "timeout": "15s",
          "replay_ttl": "5m",
          "replay_max": 10000
        }
      },
      {
        "id": "qqbot-main",
        "type": "qqbot",
        "enabled": false,
        "prompt_suffix": "",
        "options": {
          "app_id": "YOUR_APP_ID",
          "secret_ref": "qqbot/main",
          "webhook_addr": "127.0.0.1:18091",
          "webhook_path": "/qqbot",
          "timeout": "15s",
          "request_limit": 1048576,
          "replay_ttl": "5m",
          "replay_max": 10000,
          "sandbox": false
        }
      },
      {
        "id": "telegram-main",
        "type": "telegram",
        "enabled": false,
        "prompt_suffix": "",
        "options": {
          "token_ref": "telegram/main",
          "mode": "long_polling",
          "timeout": "15s"
        }
      }
    ],
    "groups": [
      {
        "id": "local",
        "connector_id": "echo-local",
        "target": "local",
        "prompt_suffix": ""
      }
    ]
  },
  "operator": {
    "conversation_id": "local",
    "notifications": true,
    "commands": [
      "status",
      "restart",
      "pause",
      "resume",
      "proactive",
      "reload_docs"
    ]
  },
  "modules": {
    "native.echo": {
      "enabled": true,
      "options": {}
    },
    "native.onebot": {
      "enabled": false,
      "options": {
        "api_url": "",
        "send_token": "",
        "receive_secret": "",
        "webhook_addr": "",
        "webhook_path": "",
        "request_limit": 1048576,
        "timeout": "15s",
        "replay_ttl": "5m",
        "replay_max": 10000
      }
    },
    "native.reply_experience": {
      "enabled": false,
      "options": {
        "empty_mention_prompt": "请简单介绍一下你自己。",
        "image_only_prompt": "请读取图片中的文字、界面和错误信息，将其视为用户本次输入，并直接处理图片中提出的问题。",
        "search_progress_text": "正在检索相关文档，请稍候。"
      }
    },
    "native.proactive_reply": {
      "enabled": false,
      "options": {
        "scope": "",
        "yield_duration": "5m",
        "silence": "4s",
        "max_window": "25s",
        "max_buffered": 50,
        "max_text_len": 500,
        "max_concurrent": 4,
        "context_messages": 10,
        "groups": {
          "local": {
            "enabled": false
          }
        }
      }
    },
    "native.structured_search": {
      "enabled": false,
      "options": {
        "document_root": "D:/forgebot-docs",
        "extensions": [
          ".md",
          ".mdx",
          ".txt"
        ],
        "default_results": 5,
        "max_results": 8,
        "min_match_ratio": 0.35,
        "query_timeout": "750ms",
        "build_timeout": "20s",
        "max_queries_per_turn": 1,
        "max_context_chars": 12000,
        "max_section_chars": 8000,
        "max_file_bytes": 4194304,
        "max_total_bytes": 268435456,
        "max_files": 10000
      }
    },
    "native.knowledge_reflection": {
      "enabled": false,
      "options": {
        "conversation_ids": [
          "local"
        ],
        "scan_interval": "15m",
        "message_ttl": "24h",
        "quiet_window": "3m",
        "max_session_duration": "30m",
        "max_messages_per_conversation": 1000,
        "max_messages_total": 10000,
        "max_message_chars": 4000,
        "max_pairs_per_scan": 50,
        "min_confidence": 0.9,
        "extra_directory": "extra"
      }
    },
    "native.qqbot": {
      "enabled": false,
      "options": {}
    },
    "native.telegram": {
      "enabled": false,
      "options": {}
    },
    "native.join_review": {
      "enabled": false,
      "options": {
        "regex": "\\S",
        "model_enabled": false,
        "rule": "申请内容须说明入群目的，并符合本群主题。",
        "combine": "and",
        "reject_reason": "请填写符合本群要求的入群申请说明。",
        "groups": {
          "local": {
            "enabled": false
          }
        },
        "external_review": {
          "url": "https://review.example.com/join",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {review/token}"
          },
          "body": "{\"application\":\"{application}\",\"user_id\":\"{user_id}\",\"conversation_id\":\"{conversation_id}\"}",
          "result_expression": ".data.approved == true"
        }
      }
    },
    "native.welcome": {
      "enabled": false,
      "options": {
        "groups": {
          "local": {
            "enabled": false,
            "message": "欢迎 {user}（{user_id}）加入 {conversation_id}！请先阅读群公告。"
          }
        }
      }
    }
  },
  "extensions": {
    "mcp": [
      {
        "id": "platform",
        "enabled": false,
        "transport": "streamable_http",
        "endpoint": "http://127.0.0.1:9000/mcp",
        "command": "",
        "args": [],
        "working_directory": "",
        "environment": {},
        "api_key_ref": "mcp/platform",
        "allowed_tools": [
          "list_models",
          "get_model_pricing",
          "get_group_multiplier"
        ],
        "timeout": "10s",
        "max_response_bytes": 1048576
      },
      {
        "id": "local-tools",
        "enabled": false,
        "transport": "stdio",
        "endpoint": "",
        "command": "node",
        "args": [
          "./extensions/local-tools/server.js"
        ],
        "working_directory": "./extensions/local-tools",
        "environment": {
          "FORGEBOT_TOOL_MODE": "readonly"
        },
        "api_key_ref": "",
        "allowed_tools": [
          "list_models"
        ],
        "timeout": "10s",
        "max_response_bytes": 1048576
      }
    ],
    "skills": {
      "directories": [],
      "max_file_bytes": 131072,
      "max_total_bytes": 1048576,
      "max_files": 64
    }
  },
  "conversation_memory": {
    "disabled": true,
    "ttl": "20m",
    "max_pairs": 6,
    "max_sessions": 1000,
    "max_pending": 8,
    "max_session_bytes": 65536,
    "max_total_bytes": 8388608
  },
  "message_history": {
    "max_messages": 50,
    "ttl": "30m",
    "max_text_chars": 1000
  },
  "agent": {
    "timeout": "90s",
    "max_turns": 6,
    "max_tool_calls": 12,
    "max_tools_per_turn": 4,
    "max_result_bytes": 65536,
    "max_context_bytes": 131072
  },
  "admission": {
    "dedup_ttl": "60s",
    "dedup_max": 10000
  }
}

{
  "bot": {
    "name": "ForgeBot",
    "system_prompt": "你是本业务的群聊助手；只对业务范围内的问题提供专业回答。"
  },
  "llm": {
    "protocol": "openai_responses",
    "base_url": "https://YOUR_API_ROOT/v1",
    "model": "YOUR_MODEL",
    "api_key_ref": "llm/default",
    "timeout": "60s"
  },
  "platforms": {
    "connectors": [
      {
        "id": "qqbot-main",
        "type": "qqbot",
        "enabled": true,
        "options": {
          "app_id": "YOUR_APP_ID",
          "secret_ref": "qqbot/main",
          "webhook_addr": "127.0.0.1:18091",
          "webhook_path": "/qqbot",
          "timeout": "15s",
          "request_limit": 1048576,
          "replay_ttl": "5m",
          "replay_max": 10000
        }
      }
    ],
    "groups": [
      {
        "id": "support",
        "connector_id": "qqbot-main",
        "target": "YOUR_GROUP_OPENID"
      }
    ]
  },
  "modules": {
    "native.qqbot": {
      "enabled": true,
      "options": {}
    }
  }
}
